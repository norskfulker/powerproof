{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "powerproof",
  "compatibility_date": "2026-08-12",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}